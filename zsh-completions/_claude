_claude_auth() {
  local -a options=(
    '(- *)'{-h,--help}'[display help for command]'
    '1: :_claude_auth_commands'
    '*::argument:->args'
  )
  local state line
  _arguments -C $options
  case $state in
    args)
      case $words[2] in
        login) _claude_call_subcommand _claude_auth_login ;;
        status) _claude_call_subcommand _claude_auth_status ;;
        logout) _arguments '1: :_default' ;;
