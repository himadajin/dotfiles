# Invoke a nested completion function after removing the current subcommand
# from $words. This lets each function use ordinary _arguments positions.
_claude_call_subcommand() {
  local function_name=$1
  local -a saved_words=("${words[@]}")
  local saved_current=$CURRENT

  words=("${words[1]}" "${words[3,-1]}")
  (( CURRENT > 1 )) && (( CURRENT-- ))
  "$function_name"
  local ret=$?

  words=("${saved_words[@]}")
  CURRENT=$saved_current
  return ret
}

