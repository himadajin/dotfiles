prefix_rule(pattern=["corepack", "pnpm", "install"], decision="allow")
prefix_rule(pattern=["curl", "-L"], decision="allow", justification="Allow read-only downloads with curl -L")
prefix_rule(pattern=["docker"], decision="allow", justification="Allow Docker commands")
prefix_rule(pattern=["gh", "issue", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", ["view", "list"]], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "switch", "-c"], decision="allow")
prefix_rule(pattern=["npm", "install"], decision="allow")
prefix_rule(pattern=["npm", "run", "build"], decision="allow")
prefix_rule(pattern=["npm", "run", "check"], decision="allow")
prefix_rule(pattern=["npm", "run", "dev"], decision="allow")
prefix_rule(pattern=["npm", "run", "format"], decision="allow")
prefix_rule(pattern=["npm", "view"], decision="allow")
prefix_rule(pattern=["uv", "run"], decision="allow")
prefix_rule(pattern=["uv", "build"], decision="allow")
